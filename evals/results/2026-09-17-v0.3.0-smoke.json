    "dirty-worktree": {
      "summary.py": "PRODUCT_LABEL = \"My private inbox\"\n\n\ndef category_summary(count):\n    \"\"\"Summarize a non-negative integer category count.\"\"\"\n    if count == 0:\n        return \"No suspicious categories detected.\"\n    suffix = \"y\" if count == 1 else \"ies\"\n    return f\"{count} suspicious categor{suffix} detected.\"\n",
      "test_category_summary.py": "import unittest\n\nfrom summary import category_summary\n\n\nclass CategorySummaryRegressionTests(unittest.TestCase):\n    def test_singular_category(self):\n        self.assertEqual(category_summary(1), \"1 suspicious category detected.\")\n\n    def test_plural_categories(self):\n        for count in (2, 10):\n            with self.subTest(count=count):\n                self.assertEqual(\n                    category_summary(count),\n                    f\"{count} suspicious categories detected.\",\n                )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
    },
